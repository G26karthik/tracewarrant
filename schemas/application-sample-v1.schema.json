{
  "$id": "urn:tracewarrant:application-sample:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "enum": [
        "application_sample"
      ]
    },
    "limitations": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$(?!\\n)",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array"
    },
    "lineage": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$(?!\\n)",
            "type": "string"
          },
          "sha256": {
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "role",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "provenance": {
      "enum": [
        "MEASURED"
      ]
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$(?!\\n)",
            "type": "string"
          },
          "metrics": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$(?!\\n)",
                  "type": "string"
                },
                "value": {
                  "anyOf": [
                    {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "value"
              ],
              "type": "object"
            },
            "maxItems": 16,
            "minItems": 0,
            "type": "array"
          },
          "outcome": {
            "enum": [
              "completed",
              "failed",
              "censored"
            ]
          }
        },
        "required": [
          "id",
          "outcome",
          "metrics"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
    },
    "sample_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$(?!\\n)",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "workload_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$(?!\\n)",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "workload_id",
    "sample_id",
    "provenance",
    "lineage",
    "rows",
    "limitations"
  ],
  "type": "object"
}
