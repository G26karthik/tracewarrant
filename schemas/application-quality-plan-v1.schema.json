{
  "$id": "urn:tracewarrant:application-quality-plan:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "enum": [
        "application_quality_plan"
      ]
    },
    "row_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$(?!\\n)",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
    },
    "sample_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$(?!\\n)",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "workload_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$(?!\\n)",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "workload_id",
    "sample_id",
    "row_ids"
  ],
  "type": "object"
}
